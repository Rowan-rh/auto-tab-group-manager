{
  "manifest_version": 3,
  "name": "Auto Tab Group Manager",
  "version": "1.0",
  "description": "自动按域名归组，支持自定义组名、多域名合并、标签页与标签组排序，以及闲置标签页管理。",
  "permissions": [
    "alarms",
    "tabGroups",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Tab Group Manager"
  }
}
